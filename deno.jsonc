{
  "tasks": {
    "dev": "vite",
    "build": "DENO_V8_FLAGS=--max_old_space_size=10240 vite build && cp CNAME .nojekyll dist/",
    "format": "dprint fmt",
    "check": "DENO_DISABLE_PEDANTIC_NODE_WARNINGS=1 deno check src/main.tsx vite.config.ts",
    "test": "deno test",
    "predeploy": "deno task build",
    "preview": "vite preview",
    "addTypeScriptVersions": "deno run -A scripts/addTypeScriptVersions.ts",
    "buildTsgo": "deno run -A scripts/buildTsgo.ts",
    "updateCompilerFiles": "deno task copyLibFiles && deno task createCompilerVersions && deno task createFactoryCode && deno task createPublicApiInfo",
    "copyLibFiles": "deno run -A scripts/copyLibFiles.ts ",
    "createCompilerVersions": "deno run -A scripts/createCompilerVersions.ts",
    "createFactoryCode": "deno run -A scripts/createFactoryCode.ts",
    "createPublicApiInfo": "deno run -A scripts/createPublicApiInfo.ts"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom"],
    "jsx": "react-jsx"
  },
  "lint": {
    "rules": {
      "include": ["verbatim-module-syntax"],
      "exclude": [
        "no-explicit-any",
        "no-sloppy-imports",
        // todo: https://github.com/denoland/deno/issues/28225
        "jsx-curly-braces"
      ]
    },
    "exclude": [
      "**/*.generated.ts",
      "src/compiler/tsgo/vendor"
    ]
  },
  "fmt": {
    "lineWidth": 120,
    "exclude": [
      "src/resources",
      "**/*.generated.ts",
      "src/compiler/tsgo/vendor"
    ]
  },
  "imports": {
    "@bjorn3/browser_wasi_shim": "npm:@bjorn3/browser_wasi_shim@^0.4.2",
    "@david/dax": "jsr:@david/dax@^0.44.1",
    "@david/dts-minify": "jsr:@david/dts-minify@^0.3.3",
    "@std/expect": "jsr:@std/expect@^1.0.17",
    "@std/semver": "jsr:@std/semver@^1.0.7",
    // Pin the bare `typescript` specifier to the classic 5.x compiler API. TypeScript
    // 7.0+ is the Go port — its npm package is a CLI stub with no compiler-API types —
    // so without this, Deno resolves `import ... from "typescript"` to 7.x and breaks
    // type-checking. (The tsgo/7.x compiler runs from wasm, not this package.)
    "typescript": "npm:typescript@5.9.3",
    // `?worker` is a vite suffix that turns a module into a web worker constructor. Vite
    // resolves it from node_modules; deno's type check can't, so point it at a stub.
    "monaco-editor/esm/vs/editor/editor.worker?worker": "./src/types/viteWorker.ts",
    "monaco-editor/esm/vs/language/typescript/ts.worker?worker": "./src/types/viteWorker.ts"
  },
  "exclude": [
    "dist",
    ".tsgo-build"
  ],
  "minimumDependencyAge": {
    "exclude": [
      "npm:typescript"
    ]
  },
  "unstable": [
    "sloppy-imports",
    "bare-node-builtins",
    "unsafe-proto"
  ]
}
